@PACKAGE_INIT@

# Find dependencies that are propagated to consumers
include(CMakeFindDependencyMacro)

# Find SMW - required dependency
find_dependency(NXP_SMW REQUIRED)

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@-targets.cmake")

# Propagate the mbedtls library search directory to consumers of el2go::el2go_rtp.
# libel2go_rtp.so privately uses mbedtls shared libraries; when cross-compiling,
# the linker needs both -L (for symbol resolution) and -rpath-link (for transitive
# versioned .so lookup) to link any executable that depends on libel2go_rtp.so.
find_package(PkgConfig QUIET)
if(PkgConfig_FOUND)
    pkg_check_modules(el2go_rtp_mbedtls QUIET mbedtls>=2)
    if(el2go_rtp_mbedtls_FOUND AND el2go_rtp_mbedtls_LIBRARY_DIRS)
        set_target_properties(el2go::el2go_rtp PROPERTIES
            INTERFACE_LINK_DIRECTORIES "${el2go_rtp_mbedtls_LIBRARY_DIRS}"
            INTERFACE_LINK_OPTIONS "LINKER:-rpath-link,${el2go_rtp_mbedtls_LIBRARY_DIRS}")
    endif()
endif()

check_required_components(@PROJECT_NAME@)
