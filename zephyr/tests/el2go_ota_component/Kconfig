# The component test compiles libs/fwual/mcuboot/fwual_mcuboot.c directly on
# native_sim (with local stubs), so it needs CONFIG_FWUAL_MCUBOOT_IMAGE_COUNT
# visible regardless of whether BOOTLOADER_MCUBOOT is enabled (the module-level
# zephyr/Kconfig only sources this fragment under BOOTLOADER_MCUBOOT=y).
