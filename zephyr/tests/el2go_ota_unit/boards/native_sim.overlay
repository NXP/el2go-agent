/ {
    chosen {
        secure_storage_its_partition = &its_partition;
    };
};

&flash0 {
    partitions {
        its_partition: partition@120000 {
            compatible = "zephyr,mapped-partition";
            label = "its";
            reg = <0x00120000 DT_SIZE_K(128)>;
        };

        ota_status_partition: partition@140000 {
            compatible = "zephyr,mapped-partition";
            label = "ota_status";
            reg = <0x00140000 DT_SIZE_K(8)>;
        };
    };
};
