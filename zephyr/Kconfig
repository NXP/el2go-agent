config EL2GO_OTA_NETWORK_BACKEND_ZEPHYR_WIFI
    bool "Zephyr WiFi network backend"
    depends on WIFI
    help
      Enables the Zephyr WiFi network backend that connects to an AP and
      waits for DHCP before returning from el2go_ota_net_init().

config EL2GO_NET_WIFI_SSID
    string "WiFi SSID"
    depends on EL2GO_OTA_NETWORK_BACKEND_ZEPHYR_WIFI
    default "your_ssid"
    help
      SSID of the WiFi access point to connect to.

config EL2GO_NET_WIFI_PSK
    string "WiFi pre-shared key (password)"
    depends on EL2GO_OTA_NETWORK_BACKEND_ZEPHYR_WIFI
    default "your_password"
    help
      Password (pre-shared key) for the WiFi access point.

