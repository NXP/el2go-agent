source "Kconfig.zephyr"

menu "EL2GO OTA Agent Core"

config EL2GO_OTA_POLL_INTERVAL_S
    int "Update polling interval (seconds)"
    default 30
    help
      How often the core agent polls the EL2GO OTA server for updates.

config EL2GO_OTA_CORE_REPORT_MAX_RETRIES
    int "Maximum status-report retries"
    default 3
    help
      Number of times the core OTA agent retries el2go_ota_report_pending_status()

endmenu
