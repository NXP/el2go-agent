source "Kconfig.zephyr"

# ---------------------------------------------------------------------------
# EdgeLock2GO RTP Agent
# ---------------------------------------------------------------------------
menu "EdgeLock2GO RTP Agent"

config EL2GO_RTP_AGENT
    bool "EdgeLock2GO RTP Agent library sources"
    select HWINFO
    help
      Enables the el2go_rtp_lib and its dependencies (keystores, datastores,
      platforms, net_crypto, protobuf, osal) for Zephyr builds.

config EL2GO_RTP_CLAIMCODE_INJECT
    bool "Enable claimcode injection from flash"
    depends on EL2GO_RTP_AGENT
    help
      Reads a claimcode blob from a fixed flash address and imports it into
      PSA ITS before provisioning.

config EL2GO_RTP_CLAIMCODE_FLASH_ADDRESS
    hex "Flash address of the claimcode blob"
    depends on EL2GO_RTP_CLAIMCODE_INJECT
    default 0x088A0000
    help
      Physical flash address where the claimcode blob is stored.
      Layout: { uint8_t indicator[4]; uint32_t size; uint8_t data[size]; }

config EL2GO_RTP_MQTT_VERIFY
    bool "Enable MQTT connectivity verification after provisioning"
    depends on EL2GO_RTP_AGENT
    select MQTT_LIB
    select MQTT_LIB_CUSTOM_TRANSPORT
    select JSON_LIBRARY
    help
      After provisioning, verifies MQTT connectivity using provisioned
      credentials. At least one MQTT backend (AWS or Azure) must be
      enabled via CONFIG_EL2GO_RTP_MQTT_AWS / CONFIG_EL2GO_RTP_MQTT_AZURE.

config EL2GO_RTP_MQTT_AWS
    bool "Enable AWS IoT Core MQTT verification"
    depends on EL2GO_RTP_MQTT_VERIFY
    help
      Verifies the AWS IoT Core device key and certificate by performing a
      TLS handshake against the configured AWS IoT Core endpoint.

config EL2GO_RTP_MQTT_AWS_KEY_ID
    hex "PSA key ID for the AWS IoT Core device private key"
    depends on EL2GO_RTP_MQTT_AWS
    default 0x83000101
    help
      PSA key store ID of the device private key provisioned by EdgeLock 2GO
      for AWS IoT Core authentication.

config EL2GO_RTP_MQTT_AWS_CERT_ID
    hex "PSA ITS UID for the AWS IoT Core device certificate"
    depends on EL2GO_RTP_MQTT_AWS
    default 0x83000102
    help
      PSA ITS UID of the device certificate provisioned by EdgeLock 2GO
      for AWS IoT Core authentication.

config EL2GO_RTP_MQTT_AZURE
    bool "Enable Azure IoT Hub MQTT verification"
    depends on EL2GO_RTP_MQTT_VERIFY
    help
      Verifies the Azure IoT Hub device key and certificate by performing a
      TLS handshake against the configured Azure IoT Hub or DPS endpoint.

config EL2GO_RTP_MQTT_AZURE_KEY_ID
    hex "PSA key ID for the Azure IoT Hub device private key"
    depends on EL2GO_RTP_MQTT_AZURE
    default 0x83000211
    help
      PSA key store ID of the device private key provisioned by EdgeLock 2GO
      for Azure IoT Hub authentication.

config EL2GO_RTP_MQTT_AZURE_CERT_ID
    hex "PSA ITS UID for the Azure IoT Hub device certificate"
    depends on EL2GO_RTP_MQTT_AZURE
    default 0x83000212
    help
      PSA ITS UID of the device certificate provisioned by EdgeLock 2GO
      for Azure IoT Hub authentication.

config EL2GO_RTP_MQTT_AWS_CLIENT_ID
    string "AWS IoT Core MQTT client ID (optional)"
    depends on EL2GO_RTP_MQTT_AWS
    default ""
    help
      Optional MQTT client ID for the AWS IoT Core connection. If left empty
      the client ID is derived dynamically from the Common Name of the device
      leaf certificate.

config EL2GO_RTP_MQTT_AZURE_REGISTRATION_ID
    string "Azure DPS device registration ID (optional)"
    depends on EL2GO_RTP_MQTT_AZURE
    default ""
    help
      Optional DPS registration ID. If left empty it is derived dynamically
      from the Common Name of the device leaf certificate.

config EL2GO_RTP_EDGELOCK2GO_HOSTNAME
    string "EdgeLock 2GO server hostname"
    depends on EL2GO_RTP_AGENT
    default ""
    help
      The hostname of the EdgeLock 2GO cloud service to connect to during
      provisioning. This value is company-specific and can be found in the
      EdgeLock 2GO portal under company settings.
      Leave empty to fall back to the compile-time default in el2go_rtp_config.h.

config EL2GO_RTP_EDGELOCK2GO_PORT
    int "EdgeLock 2GO server port"
    depends on EL2GO_RTP_AGENT
    default 443
    help
      TCP port number for the EdgeLock 2GO cloud service connection.
      Defaults to 443 (HTTPS/TLS).

config EL2GO_RTP_WHITELISTING
    bool "Enable whitelisting mode"
    depends on EL2GO_RTP_AGENT
    help
      Enables whitelisting-based provisioning flow.

config EL2GO_RTP_PLATFORM_KEY_REGISTRATION
    bool "Register EL2GO connection authentication key at platform init"
    depends on EL2GO_RTP_AGENT && !EL2GO_RTP_PSA_BACKEND_TFM
    default n
    help
      When enabled, el2go_platform_init() registers the EL2GO connection
      authentication key into PSA via the ELS PKC S50 driver. Enable for
      the el2go_rtp_agent on non-TF-M targets only. On TF-M targets the
      weak default no-op is used instead.

config EL2GO_RTP_PSA_BACKEND_TFM
    bool "Use TF-M as PSA backend (future)"
    depends on EL2GO_RTP_AGENT && BUILD_WITH_TFM
    default n
    help
      When enabled, PSA Crypto and ITS are backed by TF-M Secure Partition.
      Currently not enabled -- reserved for future TF-M re-enablement.

config EL2GO_TIME_MEASUREMENT
    bool "Enable EL2GO timing measurements"
    default y
    depends on EL2GO_RTP_AGENT
    help
      Enable performance timing measurements in the EL2GO RTP agent demo.
      Records and prints durations for claimcode injection, provisioning,
      MQTT verification, and the full session.

config EL2GO_RTP_ENABLE_INFO
    bool "Enable EL2GO RTP agent INFO logging"
    default y
    depends on EL2GO_RTP_AGENT

config EL2GO_RTP_ENABLE_WARN
    bool "Enable EL2GO RTP agent WARN logging"
    default y
    depends on EL2GO_RTP_AGENT

config EL2GO_RTP_ENABLE_ERROR
    bool "Enable EL2GO RTP agent ERROR logging"
    default y
    depends on EL2GO_RTP_AGENT

config EL2GO_RTP_ENABLE_DEBUG
    bool "Enable EL2GO RTP agent DEBUG logging"
    default n
    depends on EL2GO_RTP_AGENT

config EL2GO_RTP_ENABLE_TRACE
    bool "Enable EL2GO RTP agent TRACE logging"
    default n
    depends on EL2GO_RTP_AGENT

endmenu # EdgeLock2GO RTP Agent
