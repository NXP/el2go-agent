source "Kconfig.zephyr"

menu "EL2GO OTA Agent Advanced"

config EL2GO_OTA_ADV_POLL_INTERVAL_S
    int "Base polling interval (seconds)"
    default 3600
    range 1 86400
    help
      How often the agent checks for updates when no failures have occurred.
      On failure the scheduler backs off exponentially up to
      EL2GO_OTA_ADV_RETRY_MAX_BACKOFF_S.

config EL2GO_OTA_ADV_RETRY_INITIAL_BACKOFF_S
    int "Initial retry backoff (seconds)"
    default 60
    range 1 3600
    help
      Delay before the first retry after a check or download failure.
      Subsequent retries double this value up to the maximum.

config EL2GO_OTA_ADV_RETRY_MAX_BACKOFF_S
    int "Maximum retry backoff (seconds)"
    default 3600
    range 1 3600
    help
      Upper bound on the exponential backoff delay.

config EL2GO_OTA_ADV_DOWNLOAD_MAX_RETRIES
    int "Maximum download retry attempts"
    default 3
    help
      Number of times to retry a failed package download before
      reporting failure and backing off.

config EL2GO_OTA_ADV_REPORT_MAX_RETRIES
    int "Maximum status report retry attempts"
    default 5
    help
      Number of times to retry delivering the update status report
      to the EL2GO server before giving up.

config EL2GO_OTA_ADV_BLACKOUT_START_HOUR
    int "Blackout window start hour (0-23, set equal to END to disable)"
    default 0
    range 0 23
    help
      Hour of day (UTC) at which the blackout window begins.
      Set equal to EL2GO_OTA_ADV_BLACKOUT_END_HOUR to disable.
      Requires a valid time source (SNTP or RTC).

config EL2GO_OTA_ADV_BLACKOUT_END_HOUR
    int "Blackout window end hour (0-23)"
    default 0
    range 0 23
    help
      Hour of day (UTC) at which the blackout window ends (exclusive).
      Wraps midnight if END < START (e.g. 22-04 = 22:00 to 04:00).

config EL2GO_OTA_ADV_DEFER_WINDOW_S
    int "Minimum seconds between update attempts (0 = disabled)"
    default 100
    help
      If non-zero, the agent will not start a new download within this
      many seconds of the previous attempt.

config EL2GO_OTA_ADV_TIME_SYNC_MAX_CYCLES
    int "Maximum time-sync retry cycles before proceeding"
    default 10
    help
      Number of times the advanced OTA agent re-runs el2go_app_time_sync()
      while waiting for a valid time, before proceeding without one.

 config EL2GO_OTA_ADV_TIME_SYNC_RETRY_DELAY_MS
    int "Delay in milliseconds between time-sync retry cycles"
    default 5000
    help
      Time in milliseconds the advanced OTA agent sleeps between successive
      calls to el2go_app_time_sync() while waiting for a valid time.

endmenu
